# FireScan 3D 서버 설정. 처음 실행할 때 .env 로 복사되며, 바꾼 뒤에는 실행 명령을 다시 실행하면 적용된다.
# 업로드 접근 코드(도면을 올리는 사람만 알면 됨). 비워 두면 처음 실행 때 8자리를 자동으로 만든다
UPLOAD_CODE=
# 공유 링크·QR 에 쓸 외부 주소(예: https://firescan.example.org). 비우면 접속한 주소를 그대로 사용
PUBLIC_BASE_URL=
# nginx 하위 경로로 서비스할 때 그 경로(예: /kmy/firescan). 이때 PUBLIC_BASE_URL 에도 경로까지 적는다. 비우면 루트(/)
BASE_PATH=
PORT=8000
# 직접 설치(B) 때 대기 주소: 앞단에 nginx 를 두면 127.0.0.1, 바로 열려면 0.0.0.0
HOST=0.0.0.0
MODEL_TTL_DAYS=30
MAX_UPLOAD_MB=40
# 감사 기록: 누가(IP) 언제 무엇을(업로드·삭제·확인·코드 오입력 등) 했는지만 남긴다. 접근 코드·건물명·메모는 기록하지 않는다
# 기록 보관 일수(0 이하면 지우지 않음). 기록 파일은 비우면 <data>/audit.jsonl
# AUDIT_DAYS=90
# AUDIT_LOG=
# 앞단 nginx 의 주소(IP·CIDR, 쉼표 구분). 이 주소에서 온 요청만 nginx 가 알려 준 접속자 IP 를 믿는다. 기본 127.0.0.1
# Docker(A) 앞에 서버의 nginx 를 두면 172.16.0.0/12. '*' 는 쓰지 않는다(접속자가 IP 를 속여 오입력 제한을 피함)
# FORWARDED_ALLOW_IPS=127.0.0.1
